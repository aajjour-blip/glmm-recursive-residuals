        obs_cal$statistic))), stopifnot(all(keys %in% names(obs))), 
    newcal <- calibrate_components(obs[, keys, drop = FALSE], 
        out[, keys, drop = FALSE], alpha = 0.05), write.csv(newcal, 
        file.path(O, "cbpp_canonical_boundary_component_calibration.csv"), 
        row.names = FALSE), archcal <- read.csv("reference/cbpp_RR_B1000_component_calibration.csv", 
        check.names = FALSE), print(newcal[, c("statistic", "raw_component_p", 
