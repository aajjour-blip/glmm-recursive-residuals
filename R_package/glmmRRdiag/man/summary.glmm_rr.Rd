
\name{summary.glmm_rr}
\alias{summary.glmm_rr}
\title{Summarize a GLMM recursive-residual diagnostic}
\usage{\method{summary}{glmm_rr}(object, ...)}
\arguments{\item{object}{An object returned by \code{glmm_rr()}.}\item{...}{Ignored.}}
\description{Returns and prints observed component statistics, component p-values when calibration was requested, the raw minimum component p-value, and the calibrated omnibus \code{p_combo}.}
\value{A list of class \code{summary.glmm_rr}.}
