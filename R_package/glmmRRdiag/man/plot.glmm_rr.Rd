
\name{plot.glmm_rr}
\alias{plot.glmm_rr}
\title{Plot an indexed recursive-residual process}
\usage{\method{plot}{glmm_rr}(x, index = NULL, ...)}
\arguments{\item{x}{An object returned by \code{glmm_rr()}.}\item{index}{Character name of the diagnostic index to plot.}\item{...}{Additional graphical arguments passed to \code{plot()}.}}
\description{Produces a base-R plot of the indexed cumulative recursive-residual process.}
\value{Invisibly returns the process data used for plotting.}
